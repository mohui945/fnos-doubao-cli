#!/bin/bash
# 升级前：停掉旧版本 Web 终端，避免 socket 与进程残留。

LOG_FILE="${TRIM_PKGVAR}/install.log"
PID_FILE="${TRIM_PKGVAR}/doubao.pid"

if [ -r "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - 升级前停止旧进程 pid=${pid}" >> "${LOG_FILE}"
        kill -TERM "${pid}" 2>/dev/null
        i=0
        while kill -0 "${pid}" 2>/dev/null && [ $i -lt 10 ]; do
            sleep 1
            i=$((i + 1))
        done
        kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null
    fi
    rm -f "${PID_FILE}"
fi

rm -f "${TRIM_APPDEST}/doubao.sock" 2>/dev/null
rm -f "${TRIM_PKGVAR}/ttyd.sock" 2>/dev/null
pkill -f "${TRIM_PKGVAR}/ttyd.sock" 2>/dev/null

exit 0
