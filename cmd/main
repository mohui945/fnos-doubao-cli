#!/bin/bash
# 豆包 CLI 服务控制脚本
#
# 正常模式：启动 node server/server.js —— 它监听 fnOS 网关下发的 unix socket，
#           提供「终端 + 管理」页面，并以子进程方式管理 ttyd（Web 终端）。
# 降级模式：系统里找不到可用的 Node.js 时，直接拉起 ttyd，仅提供 Web 终端。
#
# 两种模式都只监听 unix socket，不额外开放 TCP 端口。

APP_NAME="doubao"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APP_NAME}.pid"

SOCK_NAME="${GATEWAY_SOCKET:-doubao.sock}"
SOCK_PATH="${TRIM_APPDEST}/${SOCK_NAME}"
PREFIX="${GATEWAY_PREFIX:-/app/doubao}"
TTYD_BIN="${TRIM_APPDEST}/server/ttyd"
TERM_BIN="${TRIM_APPDEST}/bin/term"
SERVER_JS="${TRIM_APPDEST}/server/server.js"

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

alive() {
    local pid
    pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 工作目录由管理页写入，失效时回退 /vol1
resolve_workspace() {
    local dir
    dir=$(head -n 1 "${TRIM_PKGVAR}/workdir" 2>/dev/null | tr -d '[:space:]')
    [ -z "${dir}" ] && dir="${DOUBAO_WORKSPACE:-/vol1}"
    [ -d "${dir}" ] || dir="/vol1"
    [ -d "${dir}" ] || dir="/"
    printf '%s' "${dir}"
}

# 保证 SSH 侧也能使用 doubao 命令（安装在 /usr/local/bin）
ensure_cli_link() {
    local target="/usr/local/bin/doubao"
    local source="${TRIM_APPDEST}/bin/doubao-cli"
    if [ ! -d /usr/local/bin ]; then
        return 0
    fi
    if [ ! -f "${target}" ] || ! cmp -s "${source}" "${target}" 2>/dev/null; then
        cp -f "${source}" "${target}" 2>/dev/null && chmod 755 "${target}" 2>/dev/null \
            && log_msg "已更新命令入口 ${target}"
    fi
}

# 找一个能用的 Node.js（>= 16）。飞牛系统自带 /usr/bin/node，
# 用户也可能装了 nodejs_v20/v22/v24 应用，按优先级探测。
find_node() {
    local c major
    for c in /usr/bin/node /usr/local/bin/node \
             /var/apps/nodejs_v24/target/bin/node \
             /var/apps/nodejs_v22/target/bin/node \
             /var/apps/nodejs_v20/target/bin/node \
             /var/apps/nodejs_v18/target/bin/node; do
        [ -x "${c}" ] || continue
        major=$("${c}" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null)
        [ -n "${major}" ] || continue
        [ "${major}" -ge 16 ] 2>/dev/null || continue
        printf '%s' "${c}"
        return 0
    done
    return 1
}

# 等待 socket 就绪（最多 $1 秒）
wait_socket() {
    local i=0
    local timeout="${1:-15}"
    while [ "${i}" -lt "${timeout}" ]; do
        [ -S "${SOCK_PATH}" ] && return 0
        alive || return 1
        sleep 1
        i=$((i + 1))
    done
    [ -S "${SOCK_PATH}" ]
}

start_process() {
    if alive; then
        log_msg "${APP_NAME} 已在运行 (pid=$(cat "${PID_FILE}"))"
        return 0
    fi

    if [ ! -x "${TTYD_BIN}" ]; then
        echo "缺少 Web 终端组件：${TTYD_BIN}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "启动失败：ttyd 不存在"
        return 1
    fi

    ensure_cli_link
    rm -f "${SOCK_PATH}"

    local workspace node_bin
    workspace=$(resolve_workspace)
    node_bin=$(find_node)

    if [ -n "${node_bin}" ] && [ -f "${SERVER_JS}" ]; then
        log_msg "启动管理服务：node=${node_bin} socket=${SOCK_PATH} prefix=${PREFIX} workspace=${workspace}"
        (
            cd "${workspace}" 2>/dev/null || cd /
            exec "${node_bin}" "${SERVER_JS}"
        ) >> "${LOG_FILE}" 2>&1 &
        printf "%s" "$!" > "${PID_FILE}"
        if ! wait_socket 25; then
            log_msg "启动失败：管理服务未创建 socket"
            stop_process >/dev/null 2>&1
            echo "管理服务启动失败，请查看应用日志。" > "${TRIM_TEMP_LOGFILE}"
            return 1
        fi
        chmod 666 "${SOCK_PATH}" 2>/dev/null
        log_msg "${APP_NAME} 启动完成（管理服务 pid=$(cat "${PID_FILE}")）"
        return 0
    fi

    # 降级：没有可用 Node，仅提供 Web 终端
    if [ ! -x "${TRIM_APPDEST}/runtime/doubao" ] && [ ! -x "${TRIM_PKGVAR}/runtime/current/doubao" ]; then
        echo "缺少豆包 CLI 运行时" > "${TRIM_TEMP_LOGFILE}"
        log_msg "启动失败：运行时不存在"
        return 1
    fi

    log_msg "未找到可用 Node.js，降级为纯终端模式：socket=${SOCK_PATH} prefix=${PREFIX} workspace=${workspace}"
    (
        cd "${workspace}" 2>/dev/null || cd /
        exec "${TTYD_BIN}" \
            -i "${SOCK_PATH}" \
            -b "${PREFIX}" \
            -W \
            -w "${workspace}" \
            -m 8 \
            -t titleFixed="豆包 CLI" \
            -t fontSize=14 \
            -t disableLeaveAlert=true \
            -t 'theme={"background":"#101216","foreground":"#E8E8EA","cursor":"#5B8CFF","selectionBackground":"#2A3550","black":"#1A1D23","red":"#FF6B6B","green":"#4ED27F","yellow":"#F2C94C","blue":"#5B8CFF","magenta":"#C084FC","cyan":"#4DD0E1","white":"#D8D8DC","brightBlack":"#5A5F6B","brightRed":"#FF8A8A","brightGreen":"#6FE39A","brightYellow":"#FFDD6B","brightBlue":"#7EA6FF","brightMagenta":"#D6A5FF","brightCyan":"#7DE6F2","brightWhite":"#FFFFFF"}' \
            -- "${TERM_BIN}"
    ) >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"

    if ! wait_socket 15; then
        log_msg "启动失败：socket 未创建"
        stop_process >/dev/null 2>&1
        echo "Web 终端启动失败，查看应用日志。" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    chmod 666 "${SOCK_PATH}" 2>/dev/null
    log_msg "${APP_NAME} 启动完成（终端 pid=$(cat "${PID_FILE}")）"
    return 0
}

# 停止豆包后台服务任务（doubao --service-start 起的守护进程）。
# 应用停用后不应留孤儿任务，所以这里按终端运行身份主动 --service-stop。
stop_service_task() {
    local bin="${TRIM_PKGVAR}/runtime/current/doubao"
    [ -x "${bin}" ] || bin="${TRIM_APPDEST}/runtime/doubao"
    [ -x "${bin}" ] || return 0

    local user home mode
    mode=$(head -n 1 "${TRIM_PKGVAR}/run-mode" 2>/dev/null | tr -d '[:space:]')
    if [ "${mode}" != "root" ]; then
        user=$(head -n 1 "${TRIM_PKGVAR}/run-user" 2>/dev/null | tr -d '[:space:]')
        if [ -n "${user}" ] && [ "${user}" != "root" ] && command -v runuser >/dev/null 2>&1; then
            home=$(getent passwd "${user}" | cut -d: -f6)
            runuser -u "${user}" -- env HOME="${home}" USER="${user}" LOGNAME="${user}" \
                "${bin}" --service-stop >/dev/null 2>&1
            log_msg "已停止后台服务任务（${user}）"
            return 0
        fi
    fi
    "${bin}" --service-stop >/dev/null 2>&1
    log_msg "已停止后台服务任务"
}

stop_process() {
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "停止 ${APP_NAME} (pid=${pid})"
            kill -TERM "${pid}" 2>/dev/null
            local i=0
            while kill -0 "${pid}" 2>/dev/null && [ $i -lt 12 ]; do
                sleep 1
                i=$((i + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                kill -KILL "${pid}" 2>/dev/null
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    # 兜底：服务异常退出时 ttyd 可能残留
    pkill -f "${TRIM_PKGVAR}/ttyd.sock" 2>/dev/null
    pkill -f "${SOCK_PATH}" 2>/dev/null
    rm -f "${SOCK_PATH}" "${TRIM_PKGVAR}/ttyd.sock"

    stop_service_task
    log_msg "${APP_NAME} 已停止"
    return 0
}

case $1 in
    start)
        start_process
        ;;
    stop)
        stop_process
        ;;
    status)
        if alive && [ -S "${SOCK_PATH}" ]; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
